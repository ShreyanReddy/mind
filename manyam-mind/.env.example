# Manyam Mind — environment variables. Copy to .env.local and fill in real
# values; .env.local is gitignored and never committed.
#
# Without these two set, the app runs in fully offline/local demo mode:
# the vault, graph, and persona all work; the Marketplace tab shows
# export/import cards and a note explaining how to configure the backend.

# Supabase project URL (Settings -> API in the Supabase dashboard).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/publishable key (Settings -> API). This key is safe to ship
# to the browser — it has no privileges beyond what Row Level Security
# grants an anonymous/authenticated client. Never put the SERVICE ROLE key
# here or anywhere in client code.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------
# The following are Edge Function secrets, NOT client env vars — they are
# never read by the Vite app and must never be prefixed VITE_. Set them via
# `supabase secrets set` (or the dashboard); most are auto-injected by the
# Supabase platform already and listed here only for documentation:
#
#   SUPABASE_URL                 auto-injected
#   SUPABASE_ANON_KEY            auto-injected
#   SUPABASE_SERVICE_ROLE_KEY    auto-injected — never exposed to the client
#   PAYMENT_PROVIDER             optional, defaults to "internal". The only
#                                 other value is "stripe", which selects the
#                                 StripeStub — every method throws
#                                 'Stripe integration on hold' until that
#                                 integration is reactivated (see
#                                 supabase/functions/_shared/payments.ts).
#                                 Do not set this to "stripe" yet.
#
#   -- Phase 4 (PLAN.md §4) — persona engine v3 --
#   ANTHROPIC_API_KEY             optional. Platform-held key used ONLY by
#                                 supabase/functions/llm-proxy — a user's own
#                                 key never reaches this project unless they
#                                 turn on Developer mode in Settings, which
#                                 skips this function entirely.
#   OPENAI_API_KEY                optional. Same as above; also doubles as
#                                 the embed function's fallback embedding
#                                 provider when VOYAGE_API_KEY isn't set.
#   GEMINI_API_KEY                optional. Same as ANTHROPIC_API_KEY, for Gemini.
#   VOYAGE_API_KEY                optional. Preferred embedding provider
#                                 (voyage-3-lite) for supabase/functions/embed;
#                                 falls back to OpenAI, else the function
#                                 returns 501 (no embedding provider configured).
#   LLM_DAILY_TOKEN_CAP           optional, defaults to 200000. Shared daily
#                                 per-user token cap enforced by both
#                                 llm-proxy and embed (supabase/functions/
#                                 _shared/usage.ts) before calling any provider.
