# Vite loads this automatically in "test" mode (Vitest), overriding
# .env.local, so the unit test suite always runs against a clean
# "backend not configured" environment — deterministic and offline,
# regardless of what real Supabase credentials a developer has in their
# local .env.local. Tests that need a configured backend mock
# src/lib/supabase.js directly instead of relying on real env vars.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
